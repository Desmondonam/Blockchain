# Copy to .env.local (git-ignored). Vite exposes ONLY variables prefixed with VITE_
# to the browser, and everything here ends up in the public JS bundle, so never put a
# real secret in a VITE_ variable.
VITE_CHAIN_ID=31337
VITE_RPC_URL=http://127.0.0.1:8545
VITE_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
VITE_INDEXER_URL=http://127.0.0.1:8000

# LOCAL DEVELOPMENT ONLY: lets you use an Anvil test account without a browser wallet.
# The app refuses to use it on any chain other than 31337. Anvil key #1 (public test key):
VITE_DEV_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
